# Raw API payloads are large and regenerable from R/01_fetch_adafda.R
data/raw/
data/processed/*.parquet
data/processed/*.rds

# Copyrighted reference material that must NOT be redistributed.
# Anchored to the repo root so it does not also swallow data/reference/,
# which holds the curated guideline links and must be tracked.
/reference/
*.pdf

